[Unit]
Description=Run the Orbit Tape indicator scan after every 1H candle close

[Timer]
# 90 seconds past the hour, so the exchange has the closed candle.
OnCalendar=*-*-* *:01:30
AccuracySec=10s
# Run a scan missed while the machine was asleep or off as soon as it is back.
Persistent=true

[Install]
WantedBy=timers.target
