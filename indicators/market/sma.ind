//
// Four simple moving averages of the chart timeframe in one indicator, 20,
// 50, 100 and 200 bars of the close by default. Each one has its own length,
// source and on/off switch; the colors follow the theme.

language(1)
indicator("SMA x4", id = "market.sma", bases = ["time", "tick"],
    description = "Four simple moving averages (20/50/100/200 by default).")
display(view = "plot", attachment = "overlay", layer_name = "SMA")
format(precision = "base_ticker_min_tick")

on1 = input.bool(true, "SMA 1", group = "SMA 1")
len1 = input.int(20, "Length", min = 1, max = 5000, group = "SMA 1")
src1 = input.source(chart.close, "SMA 1 source")
on2 = input.bool(true, "SMA 2", group = "SMA 2")
len2 = input.int(50, "Length", min = 1, max = 5000, group = "SMA 2")
src2 = input.source(chart.close, "SMA 2 source")
on3 = input.bool(true, "SMA 3", group = "SMA 3")
len3 = input.int(100, "Length", min = 1, max = 5000, group = "SMA 3")
src3 = input.source(chart.close, "SMA 3 source")
on4 = input.bool(true, "SMA 4", group = "SMA 4")
len4 = input.int(200, "Length", min = 1, max = 5000, group = "SMA 4")
src4 = input.source(chart.close, "SMA 4 source")

sma1 = ta.sma(src1, len1)
sma2 = ta.sma(src2, len2)
sma3 = ta.sma(src3, len3)
sma4 = ta.sma(src4, len4)

plot(select(on1, sma1, na), id = "sma1", title = "SMA 1", color_slot = "sma1", layer_title = "SMA 1", precision = "instrument")
plot(select(on2, sma2, na), id = "sma2", title = "SMA 2", color_slot = "sma2", layer_title = "SMA 2", precision = "instrument")
plot(select(on3, sma3, na), id = "sma3", title = "SMA 3", color_slot = "sma3", layer_title = "SMA 3", precision = "instrument")
plot(select(on4, sma4, na), id = "sma4", title = "SMA 4", color_slot = "sma4", layer_title = "SMA 4", precision = "instrument")

style("sma1", title = "SMA 1", role = "primary")
style("sma2", title = "SMA 2", role = "success")
style("sma3", title = "SMA 3", role = "warning")
style("sma4", title = "SMA 4", role = "danger")
