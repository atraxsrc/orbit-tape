//
// VWAP bands: a rolling volume-weighted average price with bands one or more
// standard deviations above and below, filled in between.
//
// Shows: ta.vwma and ta.stdev, float inputs, several plots on the price
// chart, and a fill between two plots.

language(1)
indicator("VWAP Bands", id = "example.vwap-bands", version = "1.0", max_bars_back = 1,
    description = "Rolling VWAP with standard deviation bands.")
display(view = "plot", attachment = "overlay", layer_name = "VWAP")
format(precision = "base_ticker_min_tick")

period = input.int(50, "Lookback period", min = 2, max = 500)
width = input.float(2.0, "Band width (std. deviations)", min = 0.1, max = 5.0, step = 0.1)

vwap = ta.vwma(chart.close, chart.volume, period)
deviation = ta.stdev(chart.close, period) * width

plot(vwap, id = "value", title = "VWAP", precision = "instrument", color_slot = "main", layer_title = "VWAP", width = 1.3, pane = "main")
plot(vwap + deviation, id = "upper", title = "Upper band", precision = "instrument", color_slot = "upper", layer_title = "U", pane = "main")
plot(vwap - deviation, id = "lower", title = "Lower band", precision = "instrument", color_slot = "lower", layer_title = "L", pane = "main")

style("main", title = "VWAP")
style("upper", title = "Upper band", role = "secondary")
style("lower", title = "Lower band", role = "secondary")
style("fill", title = "Band fill", role = "primary", shade = "faint")
// Shade the area between the two bands.
fill(upper = "upper", lower = "lower", geometry = "series_band", color_slot = "fill", opacity = 0.10)
